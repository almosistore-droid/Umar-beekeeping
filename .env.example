# ============================================================
#  Скопируйте этот файл в .env и заполните значения:
#      cp .env.example .env
#  Файл .env НЕ коммитится в Git (см. .gitignore).
# ============================================================

# --- Домен, на котором работает Mini App (без https://) ---
DOMAIN=bee.example.com

# --- PostgreSQL ---
POSTGRES_USER=bee
# Только латинские буквы и цифры (пароль подставляется в URL подключения)
POSTGRES_PASSWORD=change_me_long_random_password
POSTGRES_DB=beekeeping

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=8933568623:AAFb6Bmap-QU3Z7FdnEwmQZZah_ZvGGxzxU
# Имя бота без @ и короткое имя Mini App (из @BotFather → /newapp), нужны для QR-ссылок
TELEGRAM_BOT_USERNAME=Zubaidullo
TELEGRAM_WEBAPP_SHORT_NAME=
# Сколько секунд действует initData от Telegram
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Пользователи ---
# Ваш Telegram ID (узнать: @userinfobot). Эти пользователи получат роль ADMIN. Через запятую.
ADMIN_TELEGRAM_IDS= 1324431208
# Роль для всех остальных новых пользователей: VIEWER | ASSISTANT | BEEKEEPER
DEFAULT_USER_ROLE=VIEWER

# --- JWT ---
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- Backend ---
UVICORN_WORKERS=2
