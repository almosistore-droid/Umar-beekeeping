# ============================================================
#  ⚠️  ЭТОТ ФАЙЛ — ТОЛЬКО ШАБЛОН. НЕ ВПИСЫВАЙТЕ СЮДА НАСТОЯЩИЕ ТОКЕНЫ И ПАРОЛИ:
#      он хранится в GitHub и виден другим.
#  Скопируйте этот файл в .env и заполните значения:
#      cp .env.example .env
#  Файл .env НЕ коммитится в Git (см. .gitignore).
# ============================================================

# --- Домен, на котором работает Mini App (без https://) ---
DOMAIN=bee.example.com

# --- PostgreSQL ---
POSTGRES_USER=bee
# Только латинские буквы и цифры (пароль подставляется в URL подключения)
POSTGRES_PASSWORD=change_me_long_random_password
POSTGRES_DB=beekeeping

# --- Telegram ---
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Имя бота без @ — попадает в QR-коды ульев (https://t.me/ИМЯ_БОТА?startapp=hive_…).
# Укажите ДО печати наклеек: напечатанный QR потом не меняется.
TELEGRAM_BOT_USERNAME=
# Короткое имя Mini App, если создавали её через @BotFather → /newapp (ссылка станет t.me/бот/имя?startapp=…).
# Оставьте пустым, если включили «Main Mini App» (Bot Settings → Configure Mini App).
TELEGRAM_WEBAPP_SHORT_NAME=
# Сколько секунд действует initData от Telegram
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=86400

# --- Пользователи ---
# Ваш Telegram ID (узнать: @userinfobot). Эти пользователи получат роль ADMIN. Через запятую.
# Валюта, которая пишется рядом с суммами в CRM и отчётах
CURRENCY=смн

ADMIN_TELEGRAM_IDS=
# Роль для всех остальных новых пользователей: VIEWER | ASSISTANT | BEEKEEPER
DEFAULT_USER_ROLE=VIEWER

# Часовой пояс пасеки: «сегодня», даты по умолчанию и периоды отчётов считаются по нему
TIMEZONE=Asia/Dushanbe

# --- JWT ---
# Минимум 32 символа. Сгенерировать: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=720

# --- Backend ---
UVICORN_WORKERS=2

# --- Бренд этой установки (у каждого клиента подписки свой) ---
BRAND_NAME=Fayzi Umar
BRAND_SUBTITLE=Учёт пасеки
# Основной цвет (#rrggbb)
BRAND_COLOR=#f4c23b
# Путь к логотипу PNG внутри контейнера; пусто = логотип Fayzi Umar
BRAND_LOGO=

# --- Подписка: после этой даты (ГГГГ-ММ-ДД) приложение закрыто; пусто = без срока ---
SUBSCRIPTION_UNTIL=
# Контакт на экране «Подписка закончилась»: телефон, @username или ссылка
SUBSCRIPTION_CONTACT=
# 0 = пользователи, роли, пароли и журнал только в панели владельца (кнопка в панели меняет это без перезапуска)
ADMIN_IN_APP=1
