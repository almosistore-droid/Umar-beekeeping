# __SLUG__ (__DOMAIN__) — generated by deploy/client.sh from deploy/edge/site.conf.template
server {
    listen 80;
    server_name __DOMAIN__;
    location /.well-known/acme-challenge/ { root /var/www/certbot; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate     __CERT__;
    ssl_certificate_key __KEY__;

    set $bee_backend http://__SLUG__-backend:8000;
    set $bee_frontend http://__SLUG__-frontend:80;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(self), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org 'self'" always;

    # the owner API is for the owner panel inside the server only
    location /api/owner/ { return 404; }

    location = /api/auth/telegram {
        limit_req zone=auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass $bee_backend;
        include /etc/nginx/proxy_params_bee;
    }

    location ~ ^/api/auth/(login-codes|device|password)$ {
        limit_req zone=auth burst=10 nodelay;
        limit_req_status 429;
        proxy_pass $bee_backend;
        include /etc/nginx/proxy_params_bee;
    }

    location /api/ {
        limit_req zone=api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass $bee_backend;
        include /etc/nginx/proxy_params_bee;
    }

    location / {
        proxy_pass $bee_frontend;
        include /etc/nginx/proxy_params_bee;
    }
}
